pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {SlhDsaVerifier, SlhDsaSha2_128s} from "../src/SlhDsaSha2_128s.sol";
import {Vector, Vectors} from "./Vectors.sol";

/// Test data is embedded in test/Vectors.sol, generated by script/gen_vectors.sh
/// with the `rslh` Rust CLI (fresh random keys, deterministic and hedged signatures).
contract SlhDsaSha2_128sTest is Test {
    SlhDsaVerifier v;
    bytes pk;
    bytes msg_;
    bytes ctx;
    bytes det;

    function setUp() public {
        v = new SlhDsaVerifier();
        Vector memory h = Vectors.Hello();
        (pk, msg_, ctx, det) = (h.pk, h.message, h.ctx, h.sig);
        assertEq(pk.length, 32);
        assertEq(det.length, 7856);
    }

    function test_allVectorsValid() public view {
        for (uint256 i = 0; i < Vectors.COUNT; i++) {
            Vector memory t = Vectors.get(i);
            assertTrue(v.verify(t.pk, t.message, t.ctx, t.sig), "vector rejected");
        }
    }

    function test_vectorsNotInterchangeable() public view {
        // Each signature verifies only under its own key/message/context.
        for (uint256 i = 0; i < Vectors.COUNT; i++) {
            Vector memory a = Vectors.get(i);
            for (uint256 j = 0; j < Vectors.COUNT; j++) {
                if (i == j) continue;
                Vector memory b = Vectors.get(j);
                assertFalse(v.verify(b.pk, a.message, a.ctx, a.sig), "foreign key accepted");
                assertFalse(v.verify(a.pk, a.message, a.ctx, b.sig), "foreign sig accepted");
            }
        }
    }

    function test_gas() public {
        uint256 g = gasleft();
        bool ok = v.verify(pk, msg_, ctx, det);
        emit log_named_uint("verify gas (incl. call)", g - gasleft());
        assertTrue(ok);
    }

    function test_rejectWrongMessage() public view {
        assertFalse(v.verify(pk, "hello from rslH", ctx, det));
        assertFalse(v.verify(pk, bytes.concat(msg_, hex"00"), ctx, det));
    }

    function test_rejectWrongContext() public view {
        assertFalse(v.verify(pk, msg_, "apq", det));
        assertFalse(v.verify(pk, msg_, "", det));
    }

    function test_rejectWrongKey() public view {
        bytes memory bad = bytes.concat(pk);
        bad[31] ^= 0x01;
        assertFalse(v.verify(bad, msg_, ctx, det));
        bad = bytes.concat(pk);
        bad[0] ^= 0x01;
        assertFalse(v.verify(bad, msg_, ctx, det));
    }

    function test_rejectBadLengths() public view {
        assertFalse(v.verify(pk, msg_, ctx, slice(det, 7855)));
        assertFalse(v.verify(pk, msg_, ctx, bytes.concat(det, hex"00")));
        assertFalse(v.verify(slice(pk, 31), msg_, ctx, det));
        assertFalse(v.verify(pk, msg_, ctx, ""));
    }

    function test_revertContextTooLong() public {
        vm.expectRevert(SlhDsaSha2_128s.ContextTooLong.selector);
        v.verify(pk, msg_, new bytes(256), det);
    }

    function test_maxContextLengthAccepted() public view {
        // 255 is allowed (just not valid for this signature).
        assertFalse(v.verify(pk, msg_, new bytes(255), det));
    }

    /// Flip one bit in each signature region: R, FORS, and every hypertree layer
    /// (WOTS part and auth path), plus first and last bytes.
    function test_rejectBitFlips() public view {
        uint256[14] memory pos = [
            uint256(0),
            15,
            16,
            200,
            2927,
            2928,
            2928 + 559,
            2928 + 560,
            2928 + 703,
            2928 + 704 * 3 + 100,
            2928 + 704 * 6,
            2928 + 704 * 6 + 600,
            7840,
            7855
        ];
        for (uint256 i = 0; i < pos.length; i++) {
            bytes memory s = bytes.concat(det);
            s[pos[i]] ^= 0x80;
            assertFalse(v.verify(pk, msg_, ctx, s), "bit flip accepted");
        }
    }

    function testFuzz_rejectRandomFlip(uint16 p, uint8 mask) public view {
        vm.assume(mask != 0);
        bytes memory s = bytes.concat(det);
        s[uint256(p) % 7856] ^= bytes1(mask);
        assertFalse(v.verify(pk, msg_, ctx, s));
    }

    function slice(bytes memory b, uint256 n) internal pure returns (bytes memory out) {
        out = new bytes(n);
        for (uint256 i = 0; i < n; i++) {
            out[i] = b[i];
        }
    }
}
