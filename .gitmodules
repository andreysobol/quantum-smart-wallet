	path = slhsol/lib/v4-periphery
	url = https://github.com/Uniswap/v4-periphery.git
[submodule "slhsol/lib/v4-core"]
	path = slhsol/lib/v4-core
	url = https://github.com/Uniswap/v4-core.git
[submodule "slhsol/lib/permit2"]
	path = slhsol/lib/permit2
	url = https://github.com/Uniswap/permit2.git
[submodule "slhsol/lib/v3-core"]
	path = slhsol/lib/v3-core
	url = https://github.com/Uniswap/v3-core.git
[submodule "slhsol/lib/v2-core"]
	path = slhsol/lib/v2-core
