# Server-side settings for the /api functions. Nothing here reaches the browser bundle.
# Local: cp .env.example .env.local (the dev API plugin loads it for `npm run dev`/`preview`).
# Vercel: Project Settings > Environment Variables; mark the two keys as Secret (sensitive).
# NEVER prefix any of these with VITE_: Vite inlines VITE_* values into the public JavaScript.

# Operator key (secret, 32-byte hex, 0x optional). Creates accounts and pays their 0.012 ETH
# stake; the faucet also needs it to be the DemoUSDC minter. For the shared devnet this is the
# private_key in ../../.secrets/devnet-operator.json (see demo/README.md). Empty = read-only server
# (/api/config reports operatorReady: false; account creation, faucet and sponsoring are refused).
QSW_OPERATOR_PRIVATE_KEY=

# Sponsor key (secret, optional): co-signs swaps and pays their gas. Empty = the operator key.
QSW_SPONSOR_PRIVATE_KEY=

# Optional overrides. Empty = the deployment manifest's values.
# The browser calls the RPC and mempool URLs directly: for another origin, also add it to
# connect-src in vercel.json.
QSW_DEPLOYMENT_URL=
QSW_RPC_URL=
QSW_MEMPOOL_URL=

# Optional limits in raw units, plain digits (dUSDC has 6 decimals; WETH and ETH 18).
# Defaults shown; uncomment to change.
# Faucet: 1,000 dUSDC per request; refused once the account holds 5,000 dUSDC.
# QSW_FAUCET_AMOUNT=1000000000
# QSW_FAUCET_MAX_BALANCE=5000000000
# Largest sponsored swap input: 1,000 dUSDC or 0.5 WETH.
# QSW_MAX_SWAP_USDC=1000000000
# QSW_MAX_SWAP_WETH=500000000000000000
# Reserve kept on the operator and sponsor balances: 0.05 ETH.
# QSW_MIN_OPERATOR_BALANCE=50000000000000000
