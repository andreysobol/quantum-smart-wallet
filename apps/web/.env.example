# Server-side settings for the /api functions. Nothing here reaches the browser bundle.
# Local: cp .env.example .env.local and fill in the key (the dev API plugin loads .env.local for
# `npm run dev`/`preview`; .env.local is git-ignored).
# Vercel: Project Settings > Environment Variables for Production and Preview, or
#   vercel env add QSW_OPERATOR_PRIVATE_KEY production,preview --sensitive   (value on stdin)
# Mark every private key Sensitive. NEVER prefix any of these with VITE_: Vite inlines VITE_*
# values into the public JavaScript.

# Operator key (secret, 32-byte hex). Creates accounts and pays their 0.012 ETH stake, mints test
# dUSDC (it must be the DemoUSDC minter, the manifest's "deployer") and, unless a sponsor key is set,
# co-signs and pays for swaps. For the shared devnet this is the private_key field of
# ../../.secrets/devnet-operator.json. A missing or malformed value leaves the server read-only
# (/api/config reports operatorReady: false; account creation, faucet and sponsoring are refused).
QSW_OPERATOR_PRIVATE_KEY=0x<64-hex-character-operator-private-key>

# Sponsor key (secret, optional): co-signs swaps and pays their gas instead of the operator.
# QSW_SPONSOR_PRIVATE_KEY=0x<64-hex-character-sponsor-private-key>

# Shared devnet endpoints, from https://altmempool.bailo.london/deployment.json (rpcUrl, mempoolUrl).
# The server verifies chain ID, genesis hash and client profile against the manifest. The browser
# calls the RPC and mempool URLs directly: for another origin, also add it to connect-src in vercel.json.
QSW_DEPLOYMENT_URL=https://altmempool.bailo.london/deployment.json
QSW_RPC_URL=https://altmempool.bailo.london/rpc
QSW_MEMPOOL_URL=https://altmempool.bailo.london/mempool

# Optional limits in raw units, plain digits (dUSDC has 6 decimals; WETH and ETH 18).
# Defaults shown; uncomment to change.
# Faucet: 1,000 dUSDC per request; refused once the account holds 5,000 dUSDC.
# QSW_FAUCET_AMOUNT=1000000000
# QSW_FAUCET_MAX_BALANCE=5000000000
# Largest sponsored swap input: 1,000 dUSDC or 0.5 WETH.
# QSW_MAX_SWAP_USDC=1000000000
# QSW_MAX_SWAP_WETH=500000000000000000
# Reserve kept on the operator and sponsor balances: 0.05 ETH.
# QSW_MIN_OPERATOR_BALANCE=50000000000000000
