{
  "name": "qsw-web",
  "version": "0.1.0",
  "private": true,
  "description": "Quantum Smart Wallet web app: SLH-DSA keys in the browser, sponsored EIP-8141 swaps on the shared devnet",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build:wasm": "npm --prefix ../../slhts ci && npm --prefix ../../slhts run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "slhts": "file:../../slhts",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
