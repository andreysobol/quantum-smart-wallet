{
  "//": "Picked up by @vercel/node when it compiles api/*.ts (nearest tsconfig to the entrypoint). Keep it self-contained: no paths, no references, no noEmit.",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "../server/**/*.ts"],
  "exclude": ["../server/dev.ts"]
}
