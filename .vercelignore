# CLI deployments upload from the repository root; Vercel does not read .gitignore.
# Upload only the web app and the packages its build compiles (slhts, rslh).
/*
!/apps
/apps/*
!/apps/web
!/slhts
!/rslh

.secrets/
**/.secrets/
**/.state/
**/.generated/
**/.env
**/.env.*
!**/.env.example

# Local tooling state.
**/.omc

# Rebuilt on Vercel.
**/node_modules
**/target
**/dist
**/pkg
**/.vercel
**/test-results
**/playwright-report
