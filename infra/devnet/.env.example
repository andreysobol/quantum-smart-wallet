# Public configuration only. Never put PQ keys, validator mnemonic, JWT, or
# the prefunded deployer's private key in a tracked file or Docker build context.
QSW_PUBLIC_URL=https://altmempool.bailo.london
QSW_PREFUND_ADDRESS=
QSW_PREFUND_ETH=1000
# configure.py defaults to the public 0x...dEaD fee sink, keeping block-tip
# credits out of sponsor balance-delta measurements. --fee-recipient overrides.
QSW_FEE_RECIPIENT=
