FROM oven/bun@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS bun

FROM node@sha256:b8d2197aff9129d16c801a3e3e1b2a873c4946480f5a310f38056df2268c38d9 AS build
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN bun install --frozen-lockfile && bun run build:all
RUN cd packages/executor && node ../../node_modules/vitest/vitest.mjs run \
    test/services/UserOpValidation/utils/validationPrefix.test.ts \
    test/services/UserOpValidation/validators/frameTx.test.ts \
    test/services/SubscriptionService.test.ts
ARG QSW_PUBLIC_MEMPOOL_URL=https://altmempool.bailo.london/mempool
ENV QSW_PUBLIC_MEMPOOL_URL=${QSW_PUBLIC_MEMPOOL_URL}
RUN node -e 'require("fs").writeFileSync("packages/devnet-ui/.env.production.local", "VITE_EXPLORER_INSTANCES=" + JSON.stringify([{name:"Quantum Smart Wallet devnet",url:process.env.QSW_PUBLIC_MEMPOOL_URL}]) + "\n")'
RUN bun run --cwd packages/devnet-ui build \
    && cp .qsw/contracts.json packages/devnet-ui/dist/contracts.json

FROM build AS production-dependencies
RUN bun install --production --frozen-lockfile

FROM node@sha256:b8d2197aff9129d16c801a3e3e1b2a873c4946480f5a310f38056df2268c38d9 AS sidecar
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
COPY --from=production-dependencies /app/node_modules ./node_modules
COPY --from=production-dependencies /app/packages ./packages
COPY --from=production-dependencies /app/package.json ./package.json
COPY --from=build /app/.qsw /opt/qsw
RUN mkdir -p /data && chown 10001:10001 /data
USER 10001:10001
EXPOSE 14337
ENTRYPOINT ["bun", "--smol", "--bun", "./packages/cli/bin/skandha.js"]

FROM node@sha256:b8d2197aff9129d16c801a3e3e1b2a873c4946480f5a310f38056df2268c38d9 AS explorer
WORKDIR /app
COPY --from=build /app/packages/devnet-ui/dist ./public
COPY --from=build /app/.qsw/static-server.mjs ./static-server.mjs
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["node", "./static-server.mjs", "./public", "8080"]
