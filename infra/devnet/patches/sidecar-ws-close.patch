+
+describe("SubscriptionService socket ownership and close cleanup", () => {
+  it("cleans an idle closed socket immediately without a lifecycle event", async () => {
+    const svc = new SubscriptionService(new ExecutorEventBus(), logger, new ExplorerService());
+    const s = socket();
+    const id = svc.listenExplorerEvents(s);
+    await nextTick();
+    s.readyState = 3;
+    s.emit("close");
+    expect((svc as any).listeners[id]).toBeUndefined();
+    expect((svc as any).events[ExecutorEvent.explorerEvents].size).toBe(0);
+    expect(s.send).not.toHaveBeenCalled();
+  });
+
+  it("does not re-register a socket closed before the replay tick", async () => {
+    const explorer = new ExplorerService();
+    explorer.recordLifecycle({ txHash: "0x1", kind: "admitted" });
+    const svc = new SubscriptionService(new ExecutorEventBus(), logger, explorer);
+    const s = socket();
+    const id = svc.listenExplorerEvents(s, 0);
+    s.readyState = 3;
+    s.emit("close");
+    await nextTick();
+    expect((svc as any).listeners[id]).toBeUndefined();
+    expect((svc as any).events[ExecutorEvent.explorerEvents].size).toBe(0);
+    expect(s.send).not.toHaveBeenCalled();
+  });
+
+  it("does not let another socket unsubscribe the owner", async () => {
+    const explorer = new ExplorerService();
+    const svc = new SubscriptionService(new ExecutorEventBus(), logger, explorer);
+    const owner = socket(), other = socket();
+    const id = svc.listenExplorerEvents(owner);
+    svc.unsubscribe(other, id);
+    await nextTick();
+    explorer.recordLifecycle({ txHash: "0x1", kind: "admitted" });
+    expect(owner.send).toHaveBeenCalledTimes(1);
+    expect((svc as any).listeners[id]).toBe(owner);
+  });
+
+  it("uses only one close handler across repeated subscriptions and clears standard events too", async () => {
+    const svc = new SubscriptionService(new ExecutorEventBus(), logger, new ExplorerService());
+    const s = socket();
+    for (let i = 0; i < 30; i++) svc.unsubscribe(s, svc.listenExplorerEvents(s));
+    const ping = svc.listenPing(s);
+    const explorerId = svc.listenExplorerEvents(s);
+    await nextTick();
+    expect(s.listenerCount("close")).toBe(1);
+    s.readyState = 3;
+    s.emit("close");
+    expect((svc as any).listeners[ping]).toBeUndefined();
+    expect((svc as any).listeners[explorerId]).toBeUndefined();
+    expect((svc as any).events[ExecutorEvent.ping].size).toBe(0);
+  });
+
+  it("refuses registration when a socket is already closed", () => {
+    const svc = new SubscriptionService(new ExecutorEventBus(), logger, new ExplorerService());
+    const s = socket(); s.readyState = 3;
+    expect(() => svc.listenExplorerEvents(s)).toThrow("Socket is closing");
+    expect(() => svc.listenPing(s)).toThrow("Socket is closing");
+    expect(Object.keys((svc as any).listeners)).toHaveLength(0);
+  });
+});
