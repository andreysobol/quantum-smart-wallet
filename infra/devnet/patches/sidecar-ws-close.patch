+  private trackSocket(socket: WebSocket): void {
+    if (socket.readyState === WebSocket.CLOSED || socket.readyState === WebSocket.CLOSING) {
+      throw new RpcError("Socket is closing", RpcErrorCodes.INVALID_REQUEST);
+    }
+    if (this.trackedSockets.has(socket)) return;
+    this.trackedSockets.add(socket);
+    // One handler per socket, not per subscription: unsubscribe/resubscribe on
+    // an idle long-lived socket must not accumulate close handlers either.
+    socket.once("close", () => {
+      for (const [id, owner] of Object.entries(this.listeners)) {
+        if (owner === socket) this.unsubscribe(socket, id);
+      }
+    });
+  }
 
