+import {beforeEach, describe, expect, it, vi} from "vitest";
+import {screen, waitFor} from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import {renderApp} from "../testUtils";
+import {erc20Contracts, formatUnits, registrySchema, safeSourceUrl} from "./api";
+
+const ADDRESS="0x"+"12".repeat(20);
+const OTHER="0x"+"34".repeat(20);
+const HASH="0x"+"ab".repeat(32);
+const GENESIS="0x"+"cd".repeat(32);
+const registry={chainId:81411338,genesisHash:GENESIS,poolId:HASH,poolKey:{currency0:ADDRESS,currency1:OTHER,fee:3000,hooks:OTHER,tickSpacing:60},contracts:[{address:ADDRESS,name:"QuantumAccount",kind:"contract",abi:[],sourceUrl:"https://github.com/example/wallet",description:"Post-quantum account"},{address:OTHER,name:"Demo sponsor",kind:"eoa",abi:[],description:"Test ETH fee sponsor"}]};
+const status={chainId:"0x4da3d0a",genesisHash:GENESIS,indexedBlock:10,latestBlock:12,transactionCount:1,indexing:true,error:null,lastUpdated:1700000000};
+const transaction={hash:HASH,blockNumber:10,transactionIndex:0,timestamp:1700000000,from:OTHER,to:null,contractAddress:ADDRESS,payer:null,type:"0x2",status:"0x1",gasUsed:"0x5208",value:"0x0"};
+function mockChain(overrides:Record<string,unknown>={}) {
+  const methods:string[]=[];
+  vi.stubGlobal("fetch",vi.fn(async (input:unknown, init?:RequestInit)=>{
+    const url=String(input);
+    if(url.endsWith("contracts.json"))return new Response(JSON.stringify(registry));
+    if(url!=="/rpc")throw new Error("Unexpected mempool request");
+    const body=JSON.parse(String(init?.body)) as {method:string;id:number;params:unknown[]};
+    methods.push(body.method);
+    const defaults:Record<string,unknown>={qsw_explorerStatus:status,qsw_explorerTransactions:{transactions:[transaction],nextCursor:null},
+      eth_blockNumber:"0xa",eth_getBalance:"0xde0b6b3a7640000",eth_getTransactionCount:"0x3",eth_getCode:"0x6000",
+      qsw_explorerTransaction:{transaction:{hash:HASH,type:"0x2",from:OTHER,to:null,nonce:"0x0"},receipt:{status:"0x1",gasUsed:"0x5208",contractAddress:ADDRESS,effectiveGasPrice:"0x1"},block:{number:"0xa",hash:HASH,timestamp:"0x6553f100"}}};
+    return new Response(JSON.stringify({jsonrpc:"2.0",id:body.id,result:body.method in overrides?overrides[body.method]:defaults[body.method]}));
+  }));
+  return methods;
+}
+beforeEach(()=>{vi.restoreAllMocks();vi.unstubAllGlobals();localStorage.clear();});
+describe("shared chain explorer",()=>{
+  it("opens deployed addresses and labels the supplied ABI without claiming verification",async()=>{
+    mockChain();
+    renderApp({path:"/contracts",instances:[]});
+    expect(await screen.findByRole("link",{name:"QuantumAccount"})).toBeTruthy();
+    await userEvent.click(screen.getByRole("link",{name:"QuantumAccount"}));
+    expect(await screen.findByText("1 test ETH")).toBeTruthy();
+    expect(screen.getByText(/not independent source verification/)).toBeTruthy();
+    expect(screen.getByRole("link",{name:"Download ABI"}).getAttribute("download")).toBe("QuantumAccount.abi.json");
+  });
+  it("shows the singleton pool metadata and omits ABI controls for a listed EOA",async()=>{
+    mockChain({eth_getCode:"0x"});
+    renderApp({path:"/contracts",instances:[]});
+    expect(await screen.findByRole("heading",{name:"Uniswap v4 pool"})).toBeTruthy();
+    expect(screen.getByText("0.3%")).toBeTruthy();
+    await userEvent.click(screen.getByRole("link",{name:"Demo sponsor"}));
+    expect(await screen.findByRole("heading",{name:"Demo sponsor"})).toBeTruthy();
+    expect(await screen.findByText("No deployed bytecode")).toBeTruthy();
+    expect(screen.queryByRole("link",{name:"Download ABI"})).toBeNull();
+    expect(screen.queryByRole("heading",{name:"Contract artifact"})).toBeNull();
+  });
+  it("renders an unavailable sender without dropping the transaction list",async()=>{
+    mockChain({qsw_explorerTransactions:{transactions:[{...transaction,from:null}],nextCursor:null}});
+    renderApp({path:"/chain",instances:[]});
+    expect(await screen.findByText("Unavailable")).toBeTruthy();
+    expect(screen.getByTitle(HASH)).toBeTruthy();
+  });
+  it("rejects an invalid address without asking chain RPC for its state",async()=>{
+    const methods=mockChain();
+    renderApp({path:"/address/not-an-address",instances:[]});
+    expect(await screen.findByText("Not a valid Ethereum address")).toBeTruthy();
+    expect(methods).toEqual([]);
+  });
+  it("uses fixed same-origin chain RPC, renders legacy creation and partial-index warning",async()=>{
+    mockChain();
+    renderApp({path:"/chain",instances:[]});
+    expect(await screen.findByText("Created contract")).toBeTruthy();
+    expect(screen.getByText(/recent history may be incomplete/)).toBeTruthy();
+    await userEvent.click(screen.getByTitle(HASH));
+    expect(await screen.findByRole("heading",{name:"On-chain transaction"})).toBeTruthy();
+    expect(await screen.findByText("Ethereum transaction type 2")).toBeTruthy();
+    expect(screen.getByText("Created contract")).toBeTruthy();
+  });
+  it("searches complete addresses even without a selected mempool",async()=>{
+    mockChain();
+    const {router}=renderApp({path:"/contracts",instances:[]});
+    await userEvent.type(await screen.findByLabelText("Find a transaction by hash or address"),ADDRESS+"{Enter}");
+    await waitFor(()=>expect(router.state.location.pathname).toBe("/address/"+ADDRESS));
+    expect(await screen.findByText("1 test ETH")).toBeTruthy();
+  });
+  it("paginates with the backend opaque row cursor",async()=>{
+    const fetcher=mockChain();
+    const original=globalThis.fetch;
+    vi.stubGlobal("fetch",vi.fn(async(input:unknown,init?:RequestInit)=>{
+      const body=init?.body?JSON.parse(String(init.body)):null;
+      if(body?.method==="qsw_explorerTransactions") {
+        return new Response(JSON.stringify({jsonrpc:"2.0",id:body.id,result:body.params[0].before===77?
+          {transactions:[{...transaction,hash:"0x"+"ef".repeat(32),blockNumber:9}],nextCursor:null}:
+          {transactions:[transaction],nextCursor:77}}));
+      }
+      return original(input as RequestInfo,init);
+    }));
+    renderApp({path:"/chain",instances:[]});
+    await userEvent.click(await screen.findByRole("button",{name:"Load older transactions"}));
+    expect(await screen.findByTitle("0x"+"ef".repeat(32))).toBeTruthy();
+    expect(screen.getByTitle(HASH)).toBeTruthy();
+    expect(screen.queryByRole("button",{name:"Load older transactions"})).toBeNull();
+    expect(fetcher).toContain("qsw_explorerStatus");
+  });
+  it("explains an empty chain index and does not invent zero for unknown heights",async()=>{
+    mockChain({qsw_explorerStatus:{...status,chainId:null,genesisHash:null,indexedBlock:null,latestBlock:null,error:"RPC unavailable"},qsw_explorerTransactions:{transactions:[],nextCursor:null}});
+    renderApp({path:"/chain",instances:[]});
+    expect(await screen.findByText("No indexed transactions yet.")).toBeTruthy();
+    expect(await screen.findByText("RPC unavailable")).toBeTruthy();
+    expect(screen.getByText(/Indexed through block unknown of unknown/)).toBeTruthy();
+  });
+  it("retains the native transaction link without losing chain receipt facts",async()=>{
+    mockChain({qsw_explorerTransaction:{transaction:{type:"0x6",sender:OTHER,nonceSeq:"0x7",nonceKeys:["0x0"],frames:[{target:null},{target:OTHER}]},receipt:{status:"0x1",gasUsed:"0x5208",payer:OTHER},block:{number:10,hash:HASH,timestamp:1700000000}}});
+    renderApp({path:"/chain/tx/"+HASH,instances:[]});
+    const link=await screen.findByRole("link",{name:"View native frames and mempool admission details"});
+    expect(link.getAttribute("href")).toContain("/tx/"+HASH);
+    expect(screen.getByText("Native frame transaction")).toBeTruthy();
+    expect(screen.getByText("2 frames")).toBeTruthy();
+    expect(screen.getByText("(sender)")).toBeTruthy();
+    expect(screen.queryByText("Contract creation frame")).toBeNull();
+    expect(screen.getByText("Payer")).toBeTruthy();
+    expect(screen.getByText("Nonce sequence").nextElementSibling?.textContent).toBe("7");
+    expect(screen.getByText("Nonce keys").nextElementSibling?.textContent).toBe("0x0");
+    expect(screen.queryByText("Contract creation")).toBeNull();
+  });
+});
+describe("chain display guards",()=>{
+  it("lists ERC20s with the right signatures and excludes ERC721 balances",()=>{
+    const balance={type:"function",name:"balanceOf",inputs:[{type:"address"}]};
+    const decimals={type:"function",name:"decimals",inputs:[]};
+    const token={...registry.contracts[0]!,abi:[balance,decimals]};
+    expect(erc20Contracts([token,{...token,name:"PositionManager NFT",abi:[balance]}])).toEqual([token]);
+    expect(erc20Contracts([{...token,abi:[balance,{...decimals,inputs:[{type:"address"}]}]}])).toEqual([]);
+  });
+  it("keeps bigint balances precise and blocks executable source links",()=>{
+    expect(formatUnits("123456789012345678901",18,8)).toBe("123.45678901");
+    expect(safeSourceUrl("javascript:alert(1)")).toBeNull();
+    expect(safeSourceUrl("https://github.com/example/wallet")).toBe("https://github.com/example/wallet");
+    expect(registrySchema.safeParse({...registry,chainId:1337}).success).toBe(false);
+  });
+});
