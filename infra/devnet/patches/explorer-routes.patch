diff --git a/packages/devnet-ui/src/chain/api.ts b/packages/devnet-ui/src/chain/api.ts
new file mode 100644
index 0000000..5642412
--- /dev/null
+++ b/packages/devnet-ui/src/chain/api.ts
@@ -0,0 +1,119 @@
+import {useInfiniteQuery, useQuery} from "@tanstack/react-query";
+import {z} from "zod";
+import {rpcCall} from "../rpc/client";
+
+export const CHAIN_ID = 81411338;
+export const ADDRESS = /^0x[0-9a-fA-F]{40}$/;
+export const HASH = /^0x[0-9a-fA-F]{64}$/;
+const quantity = z.union([z.string(), z.number()]);
+const maybeAddress = z.string().nullable().optional();
+const contractSchema = z.object({address:z.string().regex(ADDRESS), name:z.string(), kind:z.string(),
+  abi:z.array(z.unknown()), sourceUrl:z.string().optional(), description:z.string().optional()});
+export const registrySchema = z.object({chainId:z.literal(CHAIN_ID), genesisHash:z.string().regex(HASH),
+  contracts:z.array(contractSchema), poolId:z.string().regex(HASH).optional(),
+  poolKey:z.object({currency0:z.string().regex(ADDRESS),currency1:z.string().regex(ADDRESS),fee:quantity,
+    hooks:z.string().regex(ADDRESS),tickSpacing:quantity}).optional(), abiProvenance:z.string().optional()}).passthrough();
+export type Contract = z.infer<typeof contractSchema>;
+export const summarySchema = z.object({hash:z.string().regex(HASH), blockNumber:z.number(), transactionIndex:z.number(),
+  timestamp:z.number(), from:z.string().nullable(), to:maybeAddress, contractAddress:maybeAddress, payer:maybeAddress,
+  type:quantity, status:quantity.nullable(), gasUsed:quantity.nullable(), value:quantity});
+export type ChainTransaction = z.infer<typeof summarySchema>;
+const statusSchema = z.object({chainId:quantity.nullable(), genesisHash:z.string().nullable(),
+  indexedBlock:z.number().nullable(), latestBlock:z.number().nullable(), transactionCount:z.number(), indexing:z.boolean(),
+  error:z.string().nullable().optional(), lastUpdated:z.number().nullable().optional()})
+  .refine(status=>status.chainId===null||Number(status.chainId)===CHAIN_ID,"The chain RPC is connected to a different network.");
+const pageSchema = z.object({transactions:z.array(summarySchema),nextCursor:z.number().nullable()});
+const rawObject = z.record(z.string(), z.unknown());
+const detailSchema = z.object({transaction:rawObject, receipt:rawObject.nullable(),
+  block:z.object({number:quantity,hash:z.string(),timestamp:quantity}).passthrough().nullable()}).nullable();
+const hex = z.string().regex(/^0x[0-9a-fA-F]*$/);
+
+// Shared chain RPC deliberately never follows the selected mempool instance.
+export function chainCall<S extends z.ZodType>(method:string, params:unknown[], schema:S, signal?:AbortSignal) {
+  return rpcCall("/rpc", method, params, schema, {signal});
+}
+export function useRegistry() {
+  return useQuery({queryKey:["shared-chain", "contracts"], retry:false, staleTime:60000,
+    queryFn:async ({signal}) => {
+      const response = await fetch(`${import.meta.env.BASE_URL}contracts.json`, {signal});
+      if (!response.ok) throw new Error(`Contract registry returned HTTP ${response.status}. Try again after deployment finishes.`);
+      return registrySchema.parse(await response.json());
+    }});
+}
+export function useChainStatus() {
+  return useQuery({queryKey:["shared-chain","status"], queryFn:({signal})=>chainCall("qsw_explorerStatus",[],statusSchema,signal),
+    retry:false, refetchInterval:10000});
+}
+export function useChainTransactions(address?:string) {
+  return useInfiniteQuery({queryKey:["shared-chain","transactions",address?.toLowerCase()??"all"],
+    initialPageParam:undefined as number|undefined, enabled:!address||ADDRESS.test(address), retry:false, refetchInterval:10000,
+    queryFn:({pageParam,signal})=>chainCall("qsw_explorerTransactions",[{address:address?.toLowerCase(),before:pageParam,limit:25}],pageSchema,signal),
+    getNextPageParam:page=>page.nextCursor??undefined});
+}
+export function useChainTransaction(hash:string) {
+  return useQuery({queryKey:["shared-chain","transaction",hash.toLowerCase()], enabled:HASH.test(hash),retry:false,
+    queryFn:({signal})=>chainCall("qsw_explorerTransaction",[hash.toLowerCase()],detailSchema,signal)});
+}
+export function useAddressFacts(address:string) {
+  return useQuery({queryKey:["shared-chain","address",address.toLowerCase()], enabled:ADDRESS.test(address), retry:false, refetchInterval:10000,
+    queryFn:async ({signal}) => {
+      // Pin all facts to one real block instead of combining different "latest" states.
+      const block = await chainCall("eth_blockNumber",[],hex,signal);
+      const [balance,nonce,code] = await Promise.all([
+        chainCall("eth_getBalance",[address,block],hex,signal),
+        chainCall("eth_getTransactionCount",[address,block],hex,signal),
+        chainCall("eth_getCode",[address,block],hex,signal)]);
+      return {block,balance,nonce,code};
+    }});
+}
+export function erc20Contracts(contracts:Contract[]) {
+  const signature=(item:unknown,name:string,parameters:string[])=>{
+    if(typeof item!=="object"||item===null||!("type" in item)||item.type!=="function"||
+      !("name" in item)||item.name!==name||!("inputs" in item)||!Array.isArray(item.inputs))return false;
+    return item.inputs.length===parameters.length&&item.inputs.every((input:unknown,index:number)=>
+      typeof input==="object"&&input!==null&&"type" in input&&input.type===parameters[index]);
+  };
+  return contracts.filter(contract=>contract.abi.some(item=>signature(item,"balanceOf",["address"]))&&
+    contract.abi.some(item=>signature(item,"decimals",[])));
+}
+export function formatUnits(value:string|number, decimals:number, fraction=6) {
+  const number=BigInt(value);
+  const scale=10n**BigInt(decimals);
+  const remainder=(number%scale).toString().padStart(decimals,"0").slice(0,fraction).replace(/0+$/,"");
+  return (number/scale).toLocaleString("en-US")+(remainder?"."+remainder:"");
+}
+function symbolFromAbi(value:string):string {
+  const bytes=value.slice(2);
+  let data=bytes;
+  if (bytes.length>=128&&BigInt("0x"+bytes.slice(0,64))===32n) {
+    const length=Number(BigInt("0x"+bytes.slice(64,128)));
+    if (length>256||bytes.length<128+length*2) throw new Error("Invalid token symbol");
+    data=bytes.slice(128,128+length*2);
+  }
+  return new TextDecoder().decode(Uint8Array.from(data.match(/../g)??[],byte=>parseInt(byte,16))).replace(/\0+$/,"").slice(0,64);
+}
+export function useTokenBalances(address:string, contracts:Contract[], block?:string) {
+  const tokens=erc20Contracts(contracts);
+  return useQuery({queryKey:["shared-chain","tokens",address.toLowerCase(),block,tokens.map(t=>t.address.toLowerCase())],
+    enabled:ADDRESS.test(address)&&!!block&&tokens.length>0, retry:false,
+    queryFn:({signal})=>Promise.all(tokens.map(async token=>{
+      try {
+        const call=(data:string)=>chainCall("eth_call",[{to:token.address,data},block],hex,signal);
+        const [balance,decimalValue,symbolValue]=await Promise.all([
+          call("0x70a08231"+address.slice(2).padStart(64,"0")),call("0x313ce567"),call("0x95d89b41").catch(()=>null)]);
+        const decimals=Number(BigInt(decimalValue));
+        if (!Number.isInteger(decimals)||decimals<0||decimals>255) throw new Error("Invalid token decimals");
+        return {token,balance:formatUnits(balance,decimals),symbol:symbolValue?(symbolFromAbi(symbolValue)||token.name):token.name,error:null};
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return {token,balance:null,symbol:token.name,error:"Balance unavailable"};
+      }
+    }))});
+}
+export function safeSourceUrl(value?:string) {
+  if (!value) return null;
+  try {const url=new URL(value);return url.protocol==="https:"||url.protocol==="http:"?url.href:null;} catch {return null;}
+}
+
+export function sharedMempoolUrl() {return new URL("/mempool",window.location.origin).href;}
+export function isSharedMempool(url:string) {return url.replace(/\/+$/,"")===sharedMempoolUrl();}
