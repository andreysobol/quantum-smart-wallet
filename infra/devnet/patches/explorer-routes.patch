@@ -0,0 +1,127 @@
+import {useState, type ReactNode} from "react";
+import {Link} from "@tanstack/react-router";
+import {ADDRESS, CHAIN_ID, HASH, erc20Contracts, formatUnits, safeSourceUrl, useAddressFacts, useChainStatus,
+  useChainTransaction, useChainTransactions, useRegistry, sharedMempoolUrl, useTokenBalances, type ChainTransaction, type Contract} from "../../chain/api";
+import {formatBytes, formatQuantity, shortAddress, shortHash} from "../../logic/format";
+import {Banner} from "../Banner";
+import {CopyText} from "../CopyText";
+
+const linkClass="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent";
+const buttonClass="border border-line bg-raised px-3 py-2 text-sm hover:bg-rail disabled:cursor-wait disabled:opacity-60";
+function ErrorNotice({error,retry}:{error:unknown;retry:()=>unknown}) {
+  return <Banner tone="error" title="Chain data could not be loaded" hint={error instanceof Error?error.message:"The request failed."}
+    action={<button type="button" className="underline underline-offset-4" onClick={()=>void retry()}>Try again</button>}/>;
+}
+export function AddressLink({address}:{address:string}) {
+  return <Link to="/address/$address" params={{address}} title={address} className={`${linkClass} font-mono text-sm`}>{shortAddress(address)}</Link>;
+}
+function Facts({children}:{children:ReactNode}) {
+  return <dl className="m-0 grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-[max-content_1fr]">{children}</dl>;
+}
+function Fact({name,children}:{name:string;children:ReactNode}) {
+  return <><dt className="text-ink-soft">{name}</dt><dd className="m-0 min-w-0 break-words">{children}</dd></>;
